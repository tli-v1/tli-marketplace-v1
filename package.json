{
  "name": "tli-marketplace-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:profiles": "node --test test/unit/notificationPreferences.test.mjs",
    "test:integration:profiles": "firebase emulators:exec --only dataconnect --project peak-bit-486121-n6 'node test/integration/marketplaceProfiles.integration.mjs'",
    "test:integration:application": "node test/integration/lawFirmApplication.integration.mjs",
    "test:integration:intake": "firebase emulators:exec --config firebase.integration.json --only auth,firestore,dataconnect --project peak-bit-486121-n6 \"node --test --test-force-exit test/integration/intakeEmail.integration.mjs\"",
    "test:intake:email": "RUN_LIVE_INTAKE_EMAIL=1 node --env-file-if-exists=.env.test.local --test --test-force-exit test/integration/intakeEmail.integration.mjs",
    "test:notifications": "node --test test/unit/caseIds.test.mjs",
    "test": "node --test test/unit/*.test.mjs"
  },
  "dependencies": {
    "@dataconnect/generated": "file:src/dataconnect-generated",
    "firebase": "^12.12.1",
    "lucide": "^1.14.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "smtp-server": "^3.21.1",
    "vite": "^7.2.2"
  }
}
